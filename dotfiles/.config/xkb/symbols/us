// ~/.config/xkb/symbols/us
// Custom variant: US layout with German umlaut overlay via AltGr
// AltGr + a = ä, AltGr + o = ö, AltGr + u = ü, AltGr + s = ß
// AltGr + e = € (bonus: Euro sign)
// CapsLock acts as a second AltGr (level3 switch) for ergonomics.
// Shift + AltGr gives uppercase variants: Ä Ö Ü

partial alphanumeric_keys
xkb_symbols "umlaut" {
    include "us(altgr-intl)"
    include "level3(caps_switch)"
    name[Group1] = "English (US, umlaut overlay)";

    key <AD03> { [ e, E, EuroSign,      cent         ] };  // AltGr+e = €
    key <AD07> { [ u, U, udiaeresis,    Udiaeresis   ] };  // AltGr+u = ü/Ü
    key <AD09> { [ o, O, odiaeresis,    Odiaeresis   ] };  // AltGr+o = ö/Ö
    key <AC01> { [ a, A, adiaeresis,    Adiaeresis   ] };  // AltGr+a = ä/Ä
    key <AC02> { [ s, S, ssharp,        ssharp       ] };  // AltGr+s = ß (no uppercase variant in XKB)
};