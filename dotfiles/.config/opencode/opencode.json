{
  "$schema": "https://opencode.ai/config.json",
  "model": "scadsai/meta-llama/Llama-3.3-70B-Instruct",
  "provider": {
    "scadsai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ScaDS.AI (TUD:AI)",
      "options": {
        "baseURL": "https://llm.scads.ai/v1",
        "apiKey": "{env:SCADSAI_API_KEY}"
      },
      "models": {
        "meta-llama/Llama-3.3-70B-Instruct": {
          "name": "Llama 3.3 70B",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "limit": {
            "context": 1048576,
            "output": 1048576
          }
        },
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3",
          "limit": {
            "context": 524288,
            "output": 524288
          }
        },
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash"
        },
        "MiniMaxAI/MiniMax-M3": {
          "name": "MiniMax M3"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B"
        },
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen3.8 27B"
        },
        "google/gemma-4-26B-A4B-it": {
          "name": "Gemma 4 26B"
        },
        "alias-huge": {
          "name": "Alias: Huge"
        },
        "alias-huge-no-thinking": {
          "name": "Alias: Huge (no thinking)"
        },
        "alias-reasoning": {
          "name": "Alias: Reasoning"
        },
        "alias-code": {
          "name": "Alias: Code"
        },
        "alias-vision": {
          "name": "Alias: Vision"
        },
        "alias-ha": {
          "name": "Alias: HA"
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "fd *": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "pacman *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "pip install *": "ask",
      "npm install *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      "id_ecdsa": "deny",
      "*_key": "deny",
      "auth.json": "deny"
    },
    "edit": {
      "*": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "autoupdate": false,
  "share": "disabled",
  "plugin": [
    "opencode-sandbox"
  ]
}
