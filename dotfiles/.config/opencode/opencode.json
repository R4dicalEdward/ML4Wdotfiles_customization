{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow", "git diff *": "allow", "git log *": "allow",
      "git show *": "allow", "git branch *": "allow",
      "ls *": "allow", "cat *": "allow", "find *": "allow",
      "grep *": "allow", "rg *": "allow", "fd *": "allow",
      "rm *": "deny", "rm -rf *": "deny", "sudo *": "deny",
      "chmod *": "deny", "chown *": "deny", "pacman *": "deny",
      "curl *": "ask", "wget *": "ask",
      "pip install *": "ask", "npm install *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny", "*.env.*": "deny", "*.env.example": "allow",
      "*.pem": "deny", "*.key": "deny",
      "id_rsa": "deny", "id_ed25519": "deny", "id_ecdsa": "deny",
      "*_key": "deny", "auth.json": "deny"
    },
    "edit": { "*": "ask" },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "deny"
  },
  "autoupdate": false,
  "share": "disabled"
}
