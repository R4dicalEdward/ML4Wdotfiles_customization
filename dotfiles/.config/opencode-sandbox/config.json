{
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.config/gcloud",
      "~/.kube",
      "~/.docker/config.json",
      "~/.netrc",
      "~/.env"
    ],
    "allowRead": [
      "~/.ssh/*.pub",
      "~/.gitconfig"
    ]
  },
  "network": {
    "allowedDomains": [
      "llm.scads.ai",
      "registry.npmjs.org",
      "pypi.org",
      "crates.io",
      "github.com",
      "*.github.com",
      "gitlab.hrz.tu-chemnitz.de"
    ],
    "deniedDomains": []
  }
}
