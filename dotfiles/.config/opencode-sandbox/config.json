{
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.gnupg",
      "~/.config/opencode",
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.kube",
      "~/.docker/config.json",
      "~/.netrc",
      "~/.env"
    ],
    "allowRead": [
      "~/.ssh/id_ed25519.pub",
      "~/.gitconfig"
    ]
  },
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "api.openai.com",
      "registry.npmjs.org",
      "crates.io",
      "pypi.org",
      "github.com",
      "*.github.com"
    ]
  }
}
