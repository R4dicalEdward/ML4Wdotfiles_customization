#!/usr/bin/env bash
# opencode-box — minimal, auditable bwrap wrapper for OpenCode. You own this file.
set -euo pipefail
command -v bwrap    >/dev/null || { echo "install bubblewrap" >&2; exit 1; }
command -v opencode >/dev/null || { echo "opencode not in PATH" >&2; exit 1; }

OPENCODE_DIR="$(dirname "$(command -v opencode)")"
PROJECT_DIR="$(realpath "$PWD")"

case "$PROJECT_DIR" in
  "$HOME"|"$HOME/.ssh"*|"$HOME/.gnupg"*|"/")
    echo "Run from a project subdirectory, not \$HOME." >&2; exit 1;;
esac
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" && "$(stat -c %a "$HOME/.ssh")" != 700 ]]; then
  echo "chmod 700 ~/.ssh first." >&2; exit 1
fi

exec {PW}< <(printf '%s:x:%d:%d::%s:/bin/bash\n' "$(id -un)" "$(id -u)" "$(id -g)" "$HOME")
exec {GR}< <(printf '%s:x:%d:\n' "$(id -gn)" "$(id -g)")
RESOLV="$(realpath /etc/resolv.conf 2>/dev/null || echo /etc/resolv.conf)"
mkdir -p "$HOME/.config/opencode" "$HOME/.local/share/opencode" "$HOME/.cache/opencode"

declare -a B=(
  --unshare-pid --unshare-ipc --unshare-uts --die-with-parent --new-session
  --hostname opencode-sandbox
  --dev /dev --proc /proc --tmpfs /tmp
  --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64
  --ro-bind-try /etc/ssl /etc/ssl --ro-bind-try /etc/ca-certificates /etc/ca-certificates
  --ro-bind "$RESOLV" /etc/resolv.conf --ro-bind-try /etc/hosts /etc/hosts
  --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf
  # NOTE: /etc/alternatives deliberately NOT bound — it does not exist on stock Arch
  #       and an unconditional --ro-bind of a missing source makes bwrap hard-fail.
  --file "$PW" /etc/passwd --file "$GR" /etc/group
  --tmpfs "$HOME"
  --ro-bind "$OPENCODE_DIR" /opt/opencode
  --ro-bind "$HOME/.config/opencode" "$HOME/.config/opencode"
  --bind "$HOME/.local/share/opencode" "$HOME/.local/share/opencode"
  --bind "$HOME/.cache/opencode" "$HOME/.cache/opencode"
  --bind "$PROJECT_DIR" "$PROJECT_DIR"
  --dir "/run/user/$(id -u)" --setenv XDG_RUNTIME_DIR "/run/user/$(id -u)"
  --setenv HOME "$HOME" --setenv PATH "/opt/opencode:/usr/bin"
)
# SSH: public keys + known_hosts only; forward the agent socket, never private keys.
if [[ -d "$HOME/.ssh" && ! -L "$HOME/.ssh" ]]; then
  B+=(--dir "$HOME/.ssh")
  [[ -f "$HOME/.ssh/known_hosts" ]] && B+=(--ro-bind "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts")
  for p in "$HOME/.ssh/"*.pub; do [[ -f "$p" && ! -L "$p" ]] && B+=(--ro-bind "$p" "$p"); done
fi
[[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK:-}" ]] && \
  B+=(--bind "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK" --setenv SSH_AUTH_SOCK "$SSH_AUTH_SOCK")
[[ -f "$HOME/.gitconfig" ]] && B+=(--ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig")

exec bwrap "${B[@]}" -- /opt/opencode/opencode "$@"